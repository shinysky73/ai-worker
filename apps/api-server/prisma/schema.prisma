generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  picture   String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories             PresentationHistory[]
  imageAnalysisHistories ImageAnalysisHistory[]
}

model ImageAnalysisHistory {
  id          String   @id @default(uuid())
  userId      String
  filename    String
  imageType   String
  description String
  insights    Json
  imagePath   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model PresentationHistory {
  id                    String   @id @default(uuid())
  userId                String
  filename              String
  tone                  String?
  targetMinutes         Int?
  slides                Json
  totalEstimatedSeconds Int
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
